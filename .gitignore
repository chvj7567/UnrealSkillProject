# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
SkillProject/Intermediate
SkillProject/Saved
SkillProject/Binaries

# Local-only video files (GitHub 100MB push limit — host on YouTube/CDN instead)
docs/mp4/

# DerivedDataCache (any depth)
**/DerivedDataCache/

# Plugin build artifacts (any depth)
**/Plugins/*/Binaries/
**/Plugins/*/Intermediate/
**/Plugins/*/Saved/

# Build 산출물 — 위쪽 Build/* 규칙은 슬래시가 있어 저장소 루트에만 걸린다.
# 실제 경로가 SkillProject/Build/ 라 별도 지정이 필요하다(Intermediate·Saved 와 동일한 사정).
# 디렉터리 자체를 무시하면 git 이 내부로 내려가지 않아 아래 예외가 먹지 않으므로,
# 파일만 무시하고 디렉터리는 열어 둔다.
SkillProject/Build/**
!SkillProject/Build/**/
!SkillProject/Build/**/*.ico
!SkillProject/Build/**/PakBlacklist*.txt

# 파이썬 캐시 (tools/unreal-mcp 등)
**/__pycache__/
*.py[cod]

# superpowers SDD 런타임 스크래치
.superpowers/
